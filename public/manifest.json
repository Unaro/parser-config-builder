{
  "manifest_version": 3,
  "name": "Parser Config Builder",
  "version": "1.0.0",
  "description": "Visual browser extension for creating parser configurations for manga/comic sites",
  "author": "Unaro",
  
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"],
      "css": ["src/content/styles.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Parser Config Builder"
  },
  
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": true
  },
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*",
        "assets/*",
        "*.js",
        "*.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
