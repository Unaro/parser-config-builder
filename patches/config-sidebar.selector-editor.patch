/**
 * Обновление Selector Editor: полноценная форма привязки селектора c предпросмотром
 */

import type { 
  ParserConfig, 
  ElementSelectedMessage, 
  PageType,
  TestResult 
} from '@/types';
import type { SelectorConfig } from '@/types/selector';
import type { SchemaField } from '@/types/schema';
import { SidebarUIMethods } from './config-sidebar-methods';
import { getPageTypeLabel } from './config-sidebar-helpers';

// ... остальной код класса (опущен для контекста)

private renderSelectorEditor(): string {
  const fieldName = this.selectedField!;
  const config = this.currentConfig!;
  const field = config.schema.fields.find(f => f.name === fieldName);
  const existing = config.selectors[fieldName] as SelectorConfig | undefined;

  const typeOptions = ['text','attribute','html','array','count','exists','custom']
    .map(t => `<option value="${t}" ${existing?.type===t?'selected':''}>${t}</option>`) 
    .join('');

  const primary = existing?.primary ?? '';
  const attrName = existing?.type==='attribute' ? (existing.attribute ?? 'value') : 'value';
  const fallback = (existing?.fallback ?? []).map((v,i)=>
    `<div class="pcb-fallback-item" data-index="${i}" style="display:flex;gap:8px;align-items:center;margin-bottom:6px;">
      <input type="text" value="${v.replace(/"/g,'&quot;')}" class="pcb-fallback-input" style="flex:1;padding:8px;border:1px solid #e8e8e8;border-radius:6px;font-family:monospace;font-size:12px;" />
      <button class="pcb-remove-fallback btn btn--danger btn--small" data-index="${i}">✖</button>
    </div>`
  ).join('');

  return `
    <div class="pcb-content" style="flex: 1; padding: 20px; background: white;">
      <div class="pcb-section-tabs" style="display:flex;border-bottom:2px solid #f0f0f0;margin-bottom:24px;gap:4px;">
        <button class="pcb-tab" data-section="main" style="padding:12px 20px;background:#f8f9fa;color:#666;border:none;border-radius:8px 8px 0 0;font-size:14px;font-weight:600;cursor:pointer;">ℹ️ Обзор</button>
        <button class="pcb-tab" data-section="schema" style="padding:12px 20px;background:#f8f9fa;color:#666;border:none;border-radius:8px 8px 0 0;font-size:14px;font-weight:600;cursor:pointer;">📄 Схема (${config.schema.fields.length})</button>
        <button class="pcb-tab active" data-section="selector" style="padding:12px 20px;background:#722ed1;color:white;border:none;border-radius:8px 8px 0 0;font-size:14px;font-weight:600;cursor:pointer;position:relative;top:2px;">🎯 Селектор: ${fieldName}</button>
      </div>

      <div class="pcb-selector-form" style="display:grid;grid-template-columns:1fr;gap:16px;">
        <div style="display:grid;gap:8px;">
          <label style="font-weight:600;color:#333;">Основной селектор</label>
          <div style="display:flex;gap:8px;">
            <input id="pcb-primary-selector" type="text" value="${primary.replace(/"/g,'&quot;')}" placeholder="Например, .title a" style="flex:1;padding:10px 12px;border:2px solid #e8e8e8;border-radius:8px;font-family:monospace;" />
            <button id="pcb-preview-selector" class="btn btn--outline">🔍 Предпросмотр</button>
          </div>
          <div id="pcb-preview-status" style="font-size:12px;color:#666;"></div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div>
            <label style="font-weight:600;color:#333;">Тип извлечения</label>
            <select id="pcb-extraction-type" style="width:100%;padding:10px 12px;border:2px solid #e8e8e8;border-radius:8px;">${typeOptions}</select>
          </div>
          <div id="pcb-attribute-wrap" style="${existing?.type==='attribute'?'':'display:none;'}">
            <label style="font-weight:600;color:#333;">Атрибут</label>
            <input id="pcb-attribute-name" type="text" value="${attrName}" placeholder="value / href / src" style="width:100%;padding:10px 12px;border:2px solid #e8e8e8;border-radius:8px;" />
          </div>
        </div>

        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px;">
            <label style="font-weight:600;color:#333;">Fallback селекторы</label>
            <button id="pcb-add-fallback" class="btn btn--secondary btn--small">➕ Добавить</button>
          </div>
          <div id="pcb-fallback-list">${fallback}</div>
        </div>

        <div style="display:flex;gap:12px;justify-content:flex-end;">
          <button id="pcb-clear-selector" class="btn btn--outline">♻️ Очистить</button>
          <button id="pcb-save-selector" class="btn btn--primary">💾 Сохранить</button>
        </div>
      </div>
    </div>
  `;
}

// Дополнить bindEventListeners():
private bindSelectorEditorEvents(): void {
  if (!this.sidebarElement) return;
  const typeSel = this.sidebarElement.querySelector('#pcb-extraction-type') as HTMLSelectElement | null;
  const attrWrap = this.sidebarElement.querySelector('#pcb-attribute-wrap') as HTMLElement | null;
  const previewBtn = this.sidebarElement.querySelector('#pcb-preview-selector');
  const saveBtn = this.sidebarElement.querySelector('#pcb-save-selector');
  const clearBtn = this.sidebarElement.querySelector('#pcb-clear-selector');
  const addFallbackBtn = this.sidebarElement.querySelector('#pcb-add-fallback');
  const previewStatus = this.sidebarElement.querySelector('#pcb-preview-status') as HTMLElement | null;

  if (typeSel && attrWrap) {
    typeSel.addEventListener('change', () => {
      attrWrap.style.display = typeSel.value === 'attribute' ? '' : 'none';
    });
  }

  if (previewBtn) {
    previewBtn.addEventListener('click', () => {
      const ok = this.tryPreviewSelector();
      if (previewStatus) previewStatus.textContent = ok ? 'Найден элемент' : 'Элемент не найден';
      if (previewStatus) previewStatus.style.color = ok ? '#52c41a' : '#ff4d4f';
    });
  }

  if (saveBtn) {
    saveBtn.addEventListener('click', () => this.saveSelector());
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => this.clearSelectorForm());
  }

  if (addFallbackBtn) {
    addFallbackBtn.addEventListener('click', () => this.addFallbackSelector());
  }

  // Делегирование на удаление fallback
  const list = this.sidebarElement.querySelector('#pcb-fallback-list');
  if (list) {
    list.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.classList.contains('pcb-remove-fallback')) {
        const idx = Number(target.getAttribute('data-index'));
        this.removeFallbackSelector(idx);
      }
    });
  }
}

private tryPreviewSelector(): boolean {
  const primaryInput = this.sidebarElement?.querySelector('#pcb-primary-selector') as HTMLInputElement | null;
  const selector = primaryInput?.value?.trim() ?? '';
  if (!selector) return false;
  try {
    const el = document.querySelector(selector);
    if (!el) return false;
    this.onMessage({ type: 'HIGHLIGHT_ELEMENT', selector, id: `sidebar_${Date.now()}`, timestamp: Date.now() });
    return true;
  } catch { return false; }
}

private clearSelectorForm(): void {
  (this.sidebarElement?.querySelector('#pcb-primary-selector') as HTMLInputElement | null)!.value = '';
  (this.sidebarElement?.querySelector('#pcb-extraction-type') as HTMLSelectElement | null)!.value = 'text';
  const list = this.sidebarElement?.querySelector('#pcb-fallback-list');
  if (list) list.innerHTML = '';
  const attr = this.sidebarElement?.querySelector('#pcb-attribute-name') as HTMLInputElement | null;
  if (attr) attr.value = 'value';
  const attrWrap = this.sidebarElement?.querySelector('#pcb-attribute-wrap') as HTMLElement | null;
  if (attrWrap) attrWrap.style.display = 'none';
}
